{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.audiofic.com.br",
        "EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY": "goog_seu_revenuecat_key_aqui"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.audiofic.com.br",
        "EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY": "goog_seu_revenuecat_key_aqui"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
