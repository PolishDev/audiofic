# Backend API URL for mobile app
# Replace with your machine's local IPv4 (e.g. from `ip -4 addr` or `ifconfig`)
EXPO_PUBLIC_API_URL=http://192.168.0.13:3000

# RevenueCat Public API Key (Google Play)
# Obtain from RevenueCat Dashboard > Project Settings > API Keys > Public app-specific API keys
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_your_public_api_key_here
