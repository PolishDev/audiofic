{
  "name": "audiofic",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "android": "turbo run android --filter=@audiofic/mobile",
    "ios": "turbo run ios --filter=@audiofic/mobile",
    "mobile:dev": "turbo run dev --filter=@audiofic/mobile",
    "mobile:android": "cd apps/mobile && expo run:android",
    "backend:dev": "turbo run dev --filter=@audiofic/backend",
    "backend:build": "turbo run build --filter=@audiofic/backend",
    "studio:dev": "turbo run dev --filter=@audiofic/studio",
    "studio:build": "turbo run build --filter=@audiofic/studio"
  },
  "devDependencies": {
    "turbo": "^2.11.8"
  },
  "packageManager": "bun@1.4.2"
}
