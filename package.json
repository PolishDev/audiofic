{
  "name": "shortstory",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "android": "turbo run android --filter=@shortstory/mobile",
    "ios": "turbo run ios --filter=@shortstory/mobile",
    "mobile:dev": "turbo run dev --filter=@shortstory/mobile",
    "mobile:android": "cd apps/mobile && expo run:android",
    "backend:dev": "turbo run dev --filter=@shortstory/backend",
    "backend:build": "turbo run build --filter=@shortstory/backend",
    "studio:dev": "turbo run dev --filter=@shortstory/studio",
    "studio:build": "turbo run build --filter=@shortstory/studio"
  },
  "devDependencies": {
    "turbo": "^2.11.8"
  },
  "packageManager": "bun@1.4.2"
}
